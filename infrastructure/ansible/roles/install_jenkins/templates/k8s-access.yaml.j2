apiVersion: v1
kind: Namespace
metadata:
  name: "{{ jenkins_k8s_namespace }}"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: "{{ jenkins_k8s_service_account_name }}"
  namespace: "{{ jenkins_k8s_namespace }}"
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: "{{ jenkins_k8s_agent_role_name }}"
  namespace: "{{ jenkins_k8s_namespace }}"
rules:
- apiGroups: [""]
  resources: ["pods", "pods/exec", "pods/log"]
  verbs: ["create", "delete", "get", "list", "patch", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: "{{ jenkins_k8s_agent_role_binding_name }}"
  namespace: "{{ jenkins_k8s_namespace }}"
subjects:
- kind: ServiceAccount
  name: "{{ jenkins_k8s_service_account_name }}"
  namespace: "{{ jenkins_k8s_namespace }}"
roleRef:
  kind: Role
  name: "{{ jenkins_k8s_agent_role_name }}"
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ jenkins_k8s_agent_token_name }}"
  namespace: "{{ jenkins_k8s_namespace }}"
  annotations:
    kubernetes.io/service-account.name: "{{ jenkins_k8s_service_account_name }}"
type: kubernetes.io/service-account-token
