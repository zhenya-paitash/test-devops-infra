services:
  jenkins:
    image: "{{ jenkins_image }}"
    container_name: "{{ jenkins_container_name }}"
    ports:
      - "{{ jenkins_http_port }}:8080"
      - "{{ jenkins_jnlp_port }}:50000"
    volumes:
      - "{{ jenkins_home_on_host }}:/var/jenkins_home"
    restart: unless-stopped
    environment:
      - CASC_JENKINS_CONFIG=/var/jenkins_home/jenkins.yaml
